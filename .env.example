# Canonical relational store. PostgreSQL is required for production; SQLite is
# supported for local development and deterministic tests only.
MBE_DATABASE_URL=sqlite:///data/mbe-platform.db

# Optional separate privileged URL used only by Alembic migration commands.
MBE_MIGRATION_DATABASE_URL=

# serverless = no in-process SQLAlchemy pool; pooled = conventional app process.
MBE_DATABASE_POOL_MODE=serverless

# Same-origin is the secure default. Add an explicit comma-separated allowlist.
MBE_CORS_ORIGINS=

MBE_API_PORT=8001

# Public, non-secret browser configuration. auto prefers the database-backed
# v1 API and falls back once per session to versioned static snapshots.
MBE_FRONTEND_DATA_MODE=auto

# Absolute public origin used for canonical and Open Graph metadata.
MBE_PUBLIC_SITE_URL=https://multibagger-engine.vercel.app

# Existing weekly-build controls.
MBE_CACHE_TTL_HOURS=24
MBE_THROTTLE_SECS=0

# Official NSE financial-result ingestion is an explicit operator command and
# is disabled until current NSE terms/data-use conditions have been reviewed.
MBE_NSE_INGESTION_ENABLED=false

# Bounded official-ingestion controls. Cache remains outside generated assets.
MBE_NSE_REQUEST_INTERVAL_SECONDS=0.75
MBE_NSE_FILING_CACHE_DIR=data/official-filings
MBE_NSE_MAX_DOCUMENT_BYTES=12000000
MBE_NSE_MAX_TOTAL_BYTES=120000000
MBE_NSE_MAX_REQUESTS_PER_RUN=100
MBE_NSE_MAX_RUNTIME_SECONDS=1800
MBE_NSE_USER_AGENT=MultibaggerEngine/0.1 (+official filing research; operator contact required)
